---
import './WorkCard.css';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// プレースホルダー用の頭文字（先頭の括弧・記号は飛ばす）
const initial = work.data.title.replace(/^[（）()【】\[\]「」・\s]+/, '').slice(0, 1);
const categoryLabel = {
  design: 'デザイン',
  tool: 'ツール',
  'client-work': '実務',
}[work.data.category];
---

<article class="m-work-card">
  <a href={`${base}/works/${work.id}/`} class="m-work-card__link">
    <div class="m-work-card__thumb">
      {
        work.data.thumbnail ? (
          <img
            class="m-work-card__image"
            src={`${base}${work.data.thumbnail}`}
            alt=""
            loading="lazy"
            width="640"
            height="400"
          />
        ) : (
          <div class="m-work-card__placeholder" aria-hidden="true">
            <span class="l-display">{initial}</span>
          </div>
        )
      }
    </div>
    <p class="l-meta m-work-card__meta">
      <span class="m-work-card__category">{categoryLabel}</span>
      <time class="m-work-card__date" datetime={work.data.date.toISOString().slice(0, 10)}>
        {work.data.date.getFullYear()}
      </time>
    </p>
    <h3 class="l-display m-work-card__title">{work.data.title}</h3>
    <p class="m-work-card__summary">{work.data.summary}</p>
  </a>
</article>
