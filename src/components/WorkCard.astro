---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// プレースホルダー用の頭文字（先頭の括弧・記号は飛ばす）
const initial = work.data.title.replace(/^[（）()【】\[\]「」・\s]+/, '').slice(0, 1);
const categoryLabel = {
  design: 'デザイン',
  tool: 'ツール',
  'client-work': '実務',
}[work.data.category];
---

<article class="m-work-card">
  <a href={`${base}/works/${work.id}/`} class="m-work-card__link">
    <div class="m-work-card__thumb">
      {
        work.data.thumbnail ? (
          <img
            class="m-work-card__image"
            src={`${base}${work.data.thumbnail}`}
            alt=""
            loading="lazy"
            width="640"
            height="400"
          />
        ) : (
          <div class="m-work-card__placeholder" aria-hidden="true">
            <span class="l-display">{initial}</span>
          </div>
        )
      }
    </div>
    <p class="l-meta m-work-card__meta">
      <span class="m-work-card__category">{categoryLabel}</span>
      <time class="m-work-card__date" datetime={work.data.date.toISOString().slice(0, 10)}>
        {work.data.date.getFullYear()}
      </time>
    </p>
    <h3 class="l-display m-work-card__title">{work.data.title}</h3>
    <p class="m-work-card__summary">{work.data.summary}</p>
  </a>
</article>

<style>
  .m-work-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .m-work-card__thumb {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
  }

  .m-work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .m-work-card__link:hover .m-work-card__image {
    transform: scale(1.03);
  }

  .m-work-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--line);
    font-size: 3rem;
  }

  .m-work-card__meta {
    display: flex;
    gap: 1em;
    margin-block-start: 1rem;
  }

  .m-work-card__category {
    color: var(--ai);
  }

  .m-work-card__title {
    font-size: 1.0625rem;
    margin-block-start: 0.375rem;
  }

  .m-work-card__link:hover .m-work-card__title {
    color: var(--ai);
  }

  .m-work-card__summary {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.8;
    margin-block-start: 0.375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
