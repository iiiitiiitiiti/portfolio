---
// リストモジュール。items に文字列配列を渡す。ordered で番号付きに切り替え
interface Props {
  items: string[];
  ordered?: boolean;
}

const { items, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

{
  items.length > 0 && (
    <Tag class:list={['m-list', { 'm-list--ordered': ordered }]}>
      {items.map((item) => (
        <li class="m-list__item">{item}</li>
      ))}
    </Tag>
  )
}

<style>
  .m-list {
    margin-block: 1rem;
    padding-inline-start: 1.5em;
  }

  .m-list__item {
    margin-block: 0.25rem;
  }

  .m-list__item::marker {
    color: var(--ai);
  }
</style>
