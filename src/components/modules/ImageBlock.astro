---
import './ImageBlock.css';

// 画像モジュール。クリックで原寸拡大（dialog）。src は public/ からのルートパス（例: /images/a.png）
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, alt = '', caption, width, height } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolved = src.startsWith('/') ? `${base}${src}` : src;
---

<figure class="m-image">
  <button type="button" class="m-image__zoom" aria-label="画像を拡大表示">
    <img class="m-image__img" src={resolved} alt={alt} loading="lazy" width={width} height={height} />
  </button>
  {caption && <figcaption class="l-meta m-image__caption">{caption}</figcaption>}
  <dialog class="m-image__dialog">
    <button type="button" class="m-image__close" aria-label="拡大表示を閉じる">閉じる</button>
    <img class="m-image__full" src={resolved} alt={alt} loading="lazy" />
  </dialog>
</figure>

<script>
  import './ImageBlock.js';
</script>
