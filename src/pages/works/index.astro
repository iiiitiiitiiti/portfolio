---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import WorksGrid from '../../components/WorksGrid.astro';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [
  { key: 'design', label: 'デザイン作品', tate: 'デザイン' },
  { key: 'tool', label: '自作ツール', tate: '道具' },
  { key: 'client-work', label: '実務の制作実績', tate: '実務' },
] as const;
---

<Base title="Works — Fujimoto Taiga">
  <div class="l-container">
    <h1 class="l-display u-works-index__title">Works</h1>

    {
      categories.map(({ key, label, tate }) => {
        const items = works.filter((w) => w.data.category === key);
        if (items.length === 0) return null;
        return (
          <section class="u-works-index__category">
            <div class="u-works-index__category-header">
              <p class="m-tate-label">{tate}</p>
              <h2 class="l-display u-works-index__category-title">{label}</h2>
            </div>
            <WorksGrid>
              {items.map((work) => (
                <WorkCard work={work} />
              ))}
            </WorksGrid>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .u-works-index__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    padding-block: clamp(3rem, 8vw, 5rem) 0;
  }

  .u-works-index__category {
    margin-block-start: var(--space-section);
  }

  .u-works-index__category:first-of-type {
    margin-block-start: clamp(3rem, 8vw, 5rem);
  }

  .u-works-index__category-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-block-end: 2.5rem;
  }

  .u-works-index__category-title {
    font-size: 1.375rem;
  }
</style>
