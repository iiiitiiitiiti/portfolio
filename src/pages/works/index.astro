---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [
  { key: 'design', label: 'デザイン作品', tate: 'デザイン' },
  { key: 'tool', label: '自作ツール', tate: '道具' },
  { key: 'client-work', label: '実務の制作実績', tate: '実務' },
] as const;
---

<Base title="Works — Fujimoto Taiga">
  <div class="container">
    <h1 class="display page-title">Works</h1>

    {
      categories.map(({ key, label, tate }) => {
        const items = works.filter((w) => w.data.category === key);
        if (items.length === 0) return null;
        return (
          <section class="category-section">
            <div class="category-header">
              <p class="tate-label">{tate}</p>
              <h2 class="display category-title">{label}</h2>
            </div>
            <div class="works-grid">
              {items.map((work) => (
                <WorkCard work={work} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    padding-block: clamp(3rem, 8vw, 5rem) 0;
  }

  .category-section {
    margin-block-start: var(--space-section);
  }

  .category-section:first-of-type {
    margin-block-start: clamp(3rem, 8vw, 5rem);
  }

  .category-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-block-end: 2.5rem;
  }

  .category-title {
    font-size: 1.375rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
  }
</style>
