---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Heading from '../../components/modules/Heading.astro';
import Text from '../../components/modules/Text.astro';
import ListBlock from '../../components/modules/ListBlock.astro';
import ImageBlock from '../../components/modules/ImageBlock.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// .mdx 内で import なしにモジュールを使えるよう、ここで一括注入する（.md では単に無視される）
const modules = { Heading, Text, ListBlock, ImageBlock };
const categoryLabel = {
  design: 'デザイン作品',
  tool: '自作ツール',
  'client-work': '実務の制作実績',
}[work.data.category];
---

<Base title={`${work.data.title} — Fujimoto Taiga`} description={work.data.summary}>
  <article class="l-container u-work">
    <header class="u-work__header">
      <p class="l-meta">
        <span class="u-work__category">{categoryLabel}</span>
        <time datetime={work.data.date.toISOString().slice(0, 10)}>
          {work.data.date.getFullYear()}.{String(work.data.date.getMonth() + 1).padStart(2, '0')}
        </time>
      </p>
      <h1 class="l-display u-work__title">{work.data.title}</h1>
      <p class="u-work__summary">{work.data.summary}</p>
      {
        work.data.tags.length > 0 && (
          <ul class="l-meta u-work__tag-list">
            {work.data.tags.map((tag) => (
              <li class="u-work__tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      work.data.thumbnail && (
        <img
          class="u-work__thumb"
          src={`${base}${work.data.thumbnail}`}
          alt=""
          width="1280"
          height="800"
        />
      )
    }

    <div class="u-work__body">
      <Content components={modules} />
    </div>

    {
      work.data.url && (
        <p class="u-work__url">
          <a href={work.data.url} target="_blank" rel="noopener noreferrer">
            公開ページを見る
          </a>
        </p>
      )
    }

    <p class="u-work__back"><a href={`${base}/works/`}>作品一覧へ戻る</a></p>
  </article>
</Base>

<style>
  .u-work {
    max-width: 46rem;
    padding-block-start: clamp(3rem, 8vw, 5rem);
  }

  .u-work__category {
    color: var(--ai);
    margin-inline-end: 1em;
  }

  .u-work__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-block-start: 0.75rem;
  }

  .u-work__summary {
    color: var(--muted);
    margin-block-start: 1rem;
  }

  .u-work__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin-block-start: 1.25rem;
  }

  .u-work__thumb {
    border: 1px solid var(--line);
    margin-block-start: 2.5rem;
  }

  .u-work__body {
    margin-block-start: 3rem;
  }

  /* プレーン Markdown（.md）用のフォールバックスタイル。
     .mdx でモジュールを使う場合はモジュール側の CSS が当たる */
  .u-work__body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    margin-block: 2.5rem 1rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--line);
  }

  .u-work__body :global(h3) {
    font-size: 1.0625rem;
    margin-block: 2rem 0.75rem;
  }

  .u-work__body :global(p) {
    margin-block: 1rem;
  }

  .u-work__body :global(ul) {
    padding-inline-start: 1.5em;
  }

  .u-work__body :global(img) {
    border: 1px solid var(--line);
    margin-block: 1.5rem;
  }

  .u-work__url {
    margin-block-start: 2.5rem;
  }

  .u-work__back {
    margin-block-start: 4rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }
</style>
