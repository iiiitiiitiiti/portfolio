---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import WorksGrid from '../components/WorksGrid.astro';
import '../styles/pages/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = works.slice(0, 6);
---

<Base title="Fujimoto Taiga — Portfolio">
  <section class="u-hero">
    <div class="l-container u-hero__inner">
      <p class="l-meta u-hero__index">INDEX / 2026</p>
      <div class="u-hero__body">
        <p class="l-meta u-hero__eyebrow">INDEPENDENT DESIGNER &amp; TOOL MAKER</p>
        <h1 class="l-display u-hero__title">
          VISUAL<br />SYSTEMS<br /><span>&amp; TOOLS</span>
        </h1>
        <p class="u-hero__lead">
          Webのデザインをつくりながら、制作を少し軽く、正確にするための道具もつくっています。
        </p>
      </div>
      <p class="l-meta u-hero__location">TOKYO, JAPAN<br />↓ SELECTED WORKS</p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="u-home-works">
        <div class="l-container">
          <div class="u-home-works__head"><h2 class="l-meta u-home-works__heading">SELECTED WORKS</h2><p class="l-meta">01—{String(featured.length).padStart(2, '0')}</p></div>
          <WorksGrid>
            {featured.map((work) => (
              <WorkCard work={work} />
            ))}
          </WorksGrid>
          <p class="u-home-works__more">
            <a href={`${base}/works/`}>すべての作品を見る</a>
          </p>
        </div>
      </section>
    )
  }
</Base>
