---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'デザインも、道具も、自分でつくるデザイナーのポートフォリオ' } = Astro.props;
// GitHub Pages のサブパス配信（/portfolio/）でもリンクが切れないよう、常に BASE_URL 経由でリンクする
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="u-header">
      <div class="l-container u-header__inner">
        <a href={`${base}/`} class="l-display u-header__name">FUJIMOTO Taiga</a>
        <nav aria-label="メイン">
          <ul class="u-header__nav-list">
            <li class="u-header__nav-item"><a href={`${base}/works/`} class="u-header__nav-link">Works</a></li>
            <li class="u-header__nav-item"><a href={`${base}/about/`} class="u-header__nav-link">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="u-footer">
      <div class="l-container">
        <p class="l-meta u-footer__copyright">&copy; {new Date().getFullYear()} Fujimoto Taiga</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .u-header {
    border-block-end: 1px solid var(--line);
  }

  .u-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .u-header__name {
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-decoration: none;
  }

  .u-header__nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }

  .u-header__nav-link {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
  }

  .u-header__nav-link:hover {
    color: var(--ai);
  }

  .u-footer {
    border-block-start: 1px solid var(--line);
    padding-block: 2.5rem;
    margin-block-start: var(--space-section);
  }
</style>
